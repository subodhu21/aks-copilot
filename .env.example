# ========== Azure OpenAI Models (Recommended) ==========
# Use Azure Foundry OpenAI-compatible endpoint
# Endpoint format: https://<resource>.services.ai.azure.com/openai/v1
AI_PROVIDER=azure
AZURE_INFERENCE_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_MODEL_DEPLOYMENT=gpt-5.5  # Model deployment name
AZURE_API_KEY=@keyvault:azure-api-key
AZURE_CHAT_TIMEOUT_SECONDS=30
AZURE_TEMPERATURE=1.0  # gpt-5.5 requires temperature=1.0 (default)
AZURE_MAX_TOKENS=1024

# ========== Ollama (Legacy/Local) ==========
# Uncomment to use local Ollama instead of Azure
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_PROFILE=fast
# OLLAMA_TIMEOUT_SECONDS=20
# OLLAMA_NUM_CTX=384
# OLLAMA_NUM_PREDICT=80
# OLLAMA_TEMPERATURE=0.1
# OLLAMA_NUM_THREAD=2
# OLLAMA_MAX_INPUT_CHARS=6000
# OLLAMA_KEEP_ALIVE=20m

# ========== AWS Bedrock (Alternative) ==========
# Uncomment to use AWS Bedrock instead of Azure. Uses OpenAI's open-weight
# gpt-oss models (NOT the proprietary GPT-5.x — that's Azure/OpenAI-only).
# Credentials use the standard boto3 chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# env vars, ~/.aws/credentials, or an IAM role) — no extra code needed either way.
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-2
# BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0   # or openai.gpt-oss-20b-1:0 (cheaper/faster)
# BEDROCK_TEMPERATURE=0.2
# BEDROCK_MAX_TOKENS=1024
# AWS_ACCESS_KEY_ID=@keyvault:aws-access-key-id
# AWS_SECRET_ACCESS_KEY=@keyvault:aws-secret-access-key

# Key Vault URL — secrets prefixed with @keyvault:<name> are auto-resolved at startup
AZURE_KEY_VAULT_URL=https://<your-vault>.vault.azure.net/

# ========== Kubernetes ==========
# Kubernetes context (optional, uses current context if not set)
# KUBECONFIG=~/.kube/config

# ========== API Settings ==========
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# ========== Azure DevOps Repository ==========
# Repository context for Helm-specific remediation
AZURE_DEVOPS_ORG=<your-org>
AZURE_DEVOPS_PROJECT=<your-project>
AZURE_DEVOPS_REPO=<your-repo>
AZURE_DEVOPS_PAT=@keyvault:azure-devops-pat

# ========== MS Teams Notifications ==========
# MS Teams webhook URL for pod failure alerts
# Get this from: Teams Channel > ... > Connectors > Incoming Webhook
MS_TEAMS_WEBHOOK_URL=@keyvault:ms-teams-webhook-url

# ========== Slack Notifications ==========
# Slack Incoming Webhook URL for pod failure alerts.
# Free on any Slack plan — create at: https://api.slack.com/apps > your app >
# Incoming Webhooks > Add New Webhook to Workspace
# Leave blank to skip Slack notifications.
SLACK_WEBHOOK_URL=@keyvault:slack-webhook-url

# Which channel(s) to actually send to: "slack", "teams", or "both". Default: "both".
NOTIFICATION_PROVIDER=slack

# ========== Notification Deduplication ==========
# Path to the JSON file that tracks which pods have already been notified.
# Use a persistent path (e.g. a mounted volume) when running as a cronjob.
# NOTIFICATION_STATE_FILE=/var/data/aks_notification_state.json

# How long (seconds) to suppress re-notifications for the same pod+failure reason.
# Default: 3600 (1 hour). Set lower for faster alerting, higher to reduce noise.
# NOTIFICATION_COOLDOWN_SECONDS=3600

# ========== App-Level Log Error Scanning ==========
# Scan Running (healthy) pods for application errors in logs.
LOG_ERROR_SCAN_ENABLED=true
# Minimum matching error lines to trigger alert (filters transient noise)
LOG_ERROR_THRESHOLD=3
# Number of recent log lines to scan per Running pod
LOG_TAIL_LINES=200
# Per-pod kubectl logs timeout in seconds (prevents slow pods stalling the run)
LOG_SCAN_TIMEOUT=10
# Optional: comma-separated keywords to match (overrides built-in list)
# LOG_ERROR_KEYWORDS=error,exception,fatal,critical,timeout
